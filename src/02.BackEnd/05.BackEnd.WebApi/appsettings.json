{
  "AllowedHosts": "*",
  "AppConfigBackEnd":
  {
    "AppNickName": "EBVL",
    "AppFullName": "EBVL",
    "PathBase": "/ebvl_api",
    "IsDataSeedingEnabled": true
  },
  "BackgroundJob":
  {
    "DashboardUrl": "/hf",
    "WorkerCount": 2
  },
  "Email":
  {
    "Provider": "Smtp",
    "From":
    {
      "Name": "Pertamina Solution Template",
      "Address": "noreply@pertamina.com"
    },
    "FrontEndUrl": "https://localhost:44322/soltem2",
    "Smtp":
    {
      "Server": "smtp.ethereal.email",
      "Port": 587,
      "SecureOption": "StartTls"
    },
    "EmailBlast":
    {
      "RestBaseUrl": "https://apps.pertamina.com/mblast20-api",
      "HealthCheckEndpoint": "index.html",
      "Scope": "mb.client.send",
      "ApiPathBase": "/api",
      "ResourceEndpoint": "/mails/send/noTemplate"
    }
  },
  "FileStorage":
  {
    "FolderPath": "C:\\storages\\ebvl"
  },
  "HealthCheck":
  {
    "Endpoint": "/hc",
    "UI":
    {
      "Enabled": true,
      "PollingInterval": 60,
      "Endpoints":
      {
        "Ui": "/hc-ui",
        "Api": "/hc-api"
      }
    }
  },
  "IdAMan":
  {
    "Authentication":
    {
      "AuthorityUrl": "https://login-v3.qa.idaman.pertamina.com",
      "HealthCheckEndpoint": "/healthcheck",
      "TokenEndpoint": "/connect/token",
      "ApiAudienceScope": "SolTem2.API"
    },
    "RestApi":
    {
      "BaseUrl": "https://rest-v3.qa.idaman.pertamina.com",
      "HealthCheckEndpoint": "/healthcheck",
      "PathBase": "/v1",
      "PersonalRoles":
      {
        "ResourceEndpoint": "/Applications/Roles/User",
        "Scope": "application.read"
      },
      "PositionRoles":
      {
        "ResourceEndpoint": "/Applications/Roles/Position",
        "Scope": "application.read"
      },
      "UserPositions":
      {
        "ResourceEndpoint": "/Positions/Roles",
        "Scope": "user.role"
      },
      "UserProfile":
      {
        "ResourceEndpoint": "/Users",
        "Scope": "user.read"
      }
    }
  },
  "LoggingBehavior":
  {
    "LogPayload": true,
    "MaxPayloadLength": 3000
  },
  "Otp":
  {
    "Issuer": "EBVL.Development"
  },
  "PublicHolidays":
  {
    "BaseUrl": "https://date.nager.at/api/v3/PublicHolidays"
  },
  "Secret":
  {
    "Provider": "JsonFile",
    "JsonFile":
    {
      "FilePath": "secrets.json"
    },
    "PertaminaVault":
    {
      "ServerUrl": "https://dev-dc-vault.pertamina.com:8200",
      "RoleId": "xxx",
      "SecretId": "xxx",
      "Namespace": "xxx",
      "SecretPath": "xxx",
      "MountPoint": "xxx"
    }
  },
  "Serilog":
  {
    "MinimumLevel":
    {
      "Default": "Information",
      "Override":
      {
        "Hangfire": "Warning",
        "HealthChecks.UI.Core.Notifications.WebHookFailureNotifier": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Pertamina": "Debug",
        "EBVL": "Debug",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
