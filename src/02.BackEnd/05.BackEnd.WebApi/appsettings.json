{
  "AllowedHosts": "*",
  "AppConfigBackEnd": {
    "AppNickName": "e-BVL",
    "AppFullName": "Electronic Brand Vendor List",
    "PathBaseAzure": "",
    "PathBaseLocal": "/e-bvl_api",
    "PathBase": "/e-bvl_api",
    "FrontEndBaseUrlAzure": "https://e-bvl.example.invalid",
    "FrontEndBaseUrlLocal": "https://localhost:44422/e-bvl",
    "FrontEndBaseUrl": "https://localhost:44422/e-bvl",
    "IsDataSeedingEnabled": false
  },
  "BackgroundJob": {
    "WorkerCount": 5,
    "DashboardUrl": "/hf",
    "TimeZone": "SE Asia Standard Time",
    "ProjectExpiredCron": "*/30 * * * *",
    "EmailCron": "*/10 * * * *",
    "NotificationCron": "0 */2 * * *"
  },
  "Email": {
    "Provider": "EmailBlast2",
    "From": {
      "Name": "e-BVL",
      "Address": "noreply@pertamina.com"
    },
    "EmailBlast": {
      "RestBaseUrl": "https://apps.pertamina.com/mblast20-api",
      "HealthCheckEndpoint": "index.html",
      "Scope": "mb.client.send",
      "ApiPathBase": "/api",
      "ResourceEndpoint": "/send/noTemplate"
    },
    "EmailBlast2": {
      "RestBaseUrl": "https://apps.pertamina.com/mblast20-api",
      "TokenEndpoint": "https://login.idaman.pertamina.com/connect/token",
      "HealthCheckEndpoint": "index.html",
      "Scope": "api.auth mb.client.send",
      "ApiPathBase": "/api",
      "ResourceEndpoint": {
        "SendEmailNoTemplate": "/mails/send/noTemplate",
        "Status": "/mails/status"
      }
    }
  },
  "FileStorage": {
    "FolderPath": "/tmp/e-bvl"
  },
  "AzureBlob": {
    "Connection": "UseDevelopmentStorage=true",
    "BlobContainerName": "e-bvl-dev"
  },
  "HealthCheck": {
    "Endpoint": "/hc",
    "UI": {
      "Enabled": true,
      "PollingInterval": 60,
      "Endpoints": {
        "Ui": "/hc-ui",
        "Api": "/hc-api"
      }
    }
  },
  "IdAMan": {
    "Authentication": {
      "AuthorityUrl": "https://login-v3.qa.idaman.pertamina.com",
      "HealthCheckEndpoint": "/healthcheck",
      "TokenEndpoint": "/connect/token",
      "ApiAudienceScope": "EBVL.API"
    },
    "RestApi": {
      "BaseUrl": "https://rest-v3.qa.idaman.pertamina.com",
      "HealthCheckEndpoint": "/healthcheck",
      "PathBase": "/v1",
      "PersonalRoles": {
        "ResourceEndpoint": "/Applications/Roles/User",
        "Scope": "application.read"
      },
      "PositionRoles": {
        "ResourceEndpoint": "/Applications/Roles/Position",
        "Scope": "application.read"
      },
      "UserPositions": {
        "ResourceEndpoint": "/Positions/Roles",
        "Scope": "user.role"
      },
      "UserProfile": {
        "ResourceEndpoint": "/Users",
        "Scope": "user.read"
      }
    }
  },
  "LoggingBehavior": {
    "LogPayload": true,
    "MaxPayloadLength": 3000
  },
  "Otp": {
    "Issuer": "EBVL.Development"
  },
  "PublicHolidays": {
    "BaseUrl": "https://date.nager.at/api/v3/PublicHolidays"
  },
  "Secret": {
    "Provider": "JsonFile",
    "JsonFile": {
      "FilePath": "secrets.json"
    },
    "PertaminaVault": {
      "ServerUrl": "https://dev-dc-vault.pertamina.com:8200",
      "RoleId": "xxx",
      "SecretId": "xxx",
      "Namespace": "xxx",
      "SecretPath": "xxx",
      "MountPoint": "xxx"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Warning",
        "HealthChecks.UI.Core.Notifications.WebHookFailureNotifier": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Pertamina": "Debug",
        "EBVL": "Debug",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
