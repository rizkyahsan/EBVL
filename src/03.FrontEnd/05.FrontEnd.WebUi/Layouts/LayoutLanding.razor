@inherits LayoutBase

<MudThemeProvider Theme="_theme"
                  @ref="_mudThemeProvider"
                  @bind-IsDarkMode="DisplayInfo.IsDarkMode" />
<MudPopoverProvider />

<CascadingValue Value="DisplayInfo">
    <MudLayout>
        <MudMainContent @ondblclick="ToggleDarkMode">
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingValue>
