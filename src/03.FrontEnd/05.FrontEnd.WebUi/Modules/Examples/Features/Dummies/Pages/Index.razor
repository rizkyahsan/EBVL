@page "/Examples/Dummies"
@inherits PageBase

<HtmlHead Title="@(_pageTitle)" />
<Breadcrumbs Items="@(_breadcrumbItems)" />
<PageHeader Title="@(_pageTitle)" />
<LoadingLinear IsVisible="@(_isLoading)" />
<ErrorViewer ShowSnackbar="true" Exception="_exception" />
<MudGrid>
    <MudItem xs="12" sm="6">
        <NumericFieldDefault Label="Angka 1" @bind-Value="_model.Angka1" AutoFocus="true" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <NumericFieldDefault Label="Angka 2" @bind-Value="_model.Angka2" />
    </MudItem>
</MudGrid>
<BottomButtonPanel>
    <ButtonSubmit OnClick="Submit" Disabled="_isLoading" />
</BottomButtonPanel>

@if (_items.Any())
{
    <MudGrid Class="mt-5">
        @foreach (var item in _items)
        {
            <MudItem xs="12" sm="6" md="4">
                <Paper25>
                    <MudText Typo="Typo.h3">Iterasi @item.Iterasi</MudText>
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.body1">Angka 1: @item.Angka1</MudText>
                    <MudText Typo="Typo.body1">Angka 2: @item.Angka2</MudText>
                    <MudText Typo="Typo.body1">Hasil: @item.Hasil</MudText>
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.body1">@item.Keterangan</MudText>
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.body1">Suatu DateOnly: @item.SuatuDateOnly.ToDisplayText(DateFormatFor.LongDate)</MudText>
                    <MudText Typo="Typo.body1">Suatu DateTime: @item.SuatuDateTime.ToDisplayText(DateTimeFormatFor.LongDateTime)</MudText>
                    <MudText Typo="Typo.body1">Suatu DateTimeOffset: @item.SuatuDateTimeOffset.ToDisplayText("d MMMM yyyy HH:mm:ss zzz")</MudText>
                </Paper25>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Info" Class="mt-2">
        <MudText Typo="Typo.body1">Tidak ada data yang ditampilkan.</MudText>
    </MudAlert>
}
