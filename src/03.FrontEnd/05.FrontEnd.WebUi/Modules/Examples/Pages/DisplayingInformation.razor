@page "/Examples/DisplayingInformation"
@inherits PageBase

<HtmlHead Title="@ExamplesDisplayTextFor.DisplayingInformation" />
<Breadcrumbs Items="_breadcrumbItems" />
<PageHeader Title="@ExamplesDisplayTextFor.DisplayingInformation" />
<HorizontalTabs>
    <MudTabPanel Text="From the Page, show a Dialog">
        <MudText Typo="Typo.h2" Class="mb-10">
            Add Something 1
        </MudText>
        <LoadingLinear IsVisible="_isLoading" />
        <ErrorViewer Exception="_exception1" />
        <MudForm @ref="_form1" Model="_model1" Validation="_validator1.ValidateValue">
            <MudGrid>
                <MudItem xs="12">
                    <TextFieldDefault Label="@CommonDisplayTextFor.Name"
                                      @bind-Value="_model1.Name"
                                      For="@(() => _model1.Name)"
                                      Required="true"
                                      RequiredError="@ErrorMessageFor.FieldIsRequired(CommonDisplayTextFor.Name)" />
                </MudItem>
            </MudGrid>
            <BottomButtonPanel>
                <ButtonSubmit OnClick="AddSomething1" />
            </BottomButtonPanel>
        </MudForm>
    </MudTabPanel>
    <MudTabPanel Text="From the Page, show a Snackbar">
        <MudText Typo="Typo.h2" Class="mb-10">
            Add Something 2
        </MudText>
        <LoadingLinear IsVisible="_isLoading" />
        <ErrorViewer Exception="_exception2" />
        <MudForm @ref="_form2" Model="_model2" Validation="_validator2.ValidateValue">
            <MudGrid>
                <MudItem xs="12">
                    <TextFieldDefault Label="@CommonDisplayTextFor.Name"
                                      @bind-Value="_model2.Name"
                                      For="@(() => _model2.Name)"
                                      Required="true"
                                      RequiredError="@ErrorMessageFor.FieldIsRequired(CommonDisplayTextFor.Name)" />
                </MudItem>
            </MudGrid>
            <BottomButtonPanel>
                <ButtonSubmit OnClick="AddSomething2" />
            </BottomButtonPanel>
        </MudForm>
    </MudTabPanel>
    <MudTabPanel Text="From a Dialog, show a new Dialog">
        <ButtonAdd EntityType="Something 3" OnClick="ShowDialogAddSomething3" />
    </MudTabPanel>
    <MudTabPanel Text="From a Dialog, show a Snackbar">
        <ButtonAdd EntityType="Something 4" OnClick="ShowDialogAddSomething4" />
    </MudTabPanel>
</HorizontalTabs>
