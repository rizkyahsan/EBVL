<div class="vendor-actions">
    <button type="button" class="vendor-button danger" @onclick="OnBack">BACK</button>
    @if (Submit)
    {
        <button type="submit" class="vendor-button success" disabled="@Disabled" @onclick="OnSubmitClick">Kirim Pendaftaran</button>
    }
    else
    {
        <button type="button" class="vendor-button success" disabled="@Disabled" @onclick="OnNext">NEXT</button>
    }
</div>

@code {
    [Parameter]
    public bool Submit { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnSubmitClick { get; set; }
}
