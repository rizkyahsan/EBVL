<MudDialog>
    <DialogContent>
        <div class="text-center pa-6">
            <MudText Typo="Typo.h3" Class="mb-6">SEND DATA VENDOR</MudText>
            <MudText Typo="Typo.h5">Anda akan mengirimkan data Vendor Registrasi, apakah Anda yakin?</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">Ya</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Cancel">Tidak</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
