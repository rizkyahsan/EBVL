@page "/Vendor/Registration/Summary"
@attribute [Authorize(Roles = "Vendor")]

<HtmlHead Title="Detail Informasi Vendor" />
<div class="vendor-summary">
    <h1>DETAIL INFORMASI VENDOR</h1>
    <MudText Typo="Typo.h5">@_companyName</MudText>
    <div class="vendor-summary-grid">
        <MudPaper Class="pa-6">
            <MudText><b>Email Perusahaan</b><br />@_email</MudText>
            <MudText Class="mt-4"><b>NO SAP Vendor</b><br />@_sapVendorNumber</MudText>
        </MudPaper>
        <MudPaper Class="pa-6">
            <MudText><b>Status Registrasi</b><br />@_status</MudText>
            <MudText Class="mt-4">Data registrasi telah dikirim dan menunggu proses verifikasi.</MudText>
        </MudPaper>
    </div>
</div>
