@page "/MasterData/Countries"
@using EBVL.Shared.Dto.Modules.MasterData.Countries.GetCountries
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Countries.Components
@inherits PageBase
@attribute [Authorize(Policy = MasterDataPermissions.MasterDataCountriesRead)]

<HtmlHead Title="@CountriesDisplayTextFor.Countries" />
<Breadcrumbs Items="@(_breadcrumbItems)" />
<PageHeader Title="@CountriesDisplayTextFor.Countries" />
<ErrorViewer Exception="@(_exception)" />
<AuthorizeView Policy="@MasterDataPermissions.MasterDataCountriesWrite">
    <Authorized>
        <TopButtonPanel>
            <ButtonAdd Size="Size.Small" EntityType="@CountriesDisplayTextFor.Country" OnClick="ShowDrawerAdd" />
        </TopButtonPanel>
    </Authorized>
</AuthorizeView>
<TableDefault Items="_items"
              Loading="@(_isLoading)"
              Filter="FilterItems">
    <ToolBarContent>
        <MudSpacer />
        <TextFieldSearch @bind-Value="_searchKeyword" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<CountryItem, object>(x => x.Name)"
                               InitialDirection="SortDirection.Ascending">
                @CommonDisplayTextFor.Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<CountryItem, object>(x => x.Code)">
                @CommonDisplayTextFor.Code
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            @CountriesDisplayTextFor.Region
        </MudTh>
          <MudTh>
            <MudTableSortLabel SortBy="new Func<CountryItem, object>(x => x.PhoneCode)">
                @CountriesDisplayTextFor.PhoneCode
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<CountryItem, object>(x => x.CurrencyCode)">
                @CountriesDisplayTextFor.CurrencyCode
            </MudTableSortLabel>
        </MudTh>
        <MudTh Style="width: 20%;" Class="text-center">
            @CommonDisplayTextFor.Action
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@CommonDisplayTextFor.Name">
            <LinkDefault Href="@MasterDataCountriesRouteFor.Details(context.Id)">
                <MudHighlighter Text="@context.Name" HighlightedText="@_searchKeyword" />
            </LinkDefault>
        </MudTd>
        <MudTd DataLabel="@CommonDisplayTextFor.Code">
            <MudHighlighter Text="@context.Code" HighlightedText="@_searchKeyword" />
        </MudTd>
        <MudTd DataLabel="@CountriesDisplayTextFor.Region">
            <MudHighlighter Text="@context.Region" HighlightedText="@_searchKeyword" />
        </MudTd>
        <MudTd DataLabel="@CountriesDisplayTextFor.PhoneCode">
            <MudHighlighter Text="@context.PhoneCode" HighlightedText="@_searchKeyword" />
        </MudTd>
        <MudTd DataLabel="@CountriesDisplayTextFor.CurrencyCode">
            <MudHighlighter Text="@context.CurrencyCode" HighlightedText="@_searchKeyword" />
        </MudTd>
        <MudTd DataLabel="@CommonDisplayTextFor.Action" Class="text-center">
            <MudStack Row="true" Style="width:100%;" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                <ButtonDetails Size="Size.Small" OnClick="@(() => ShowDrawerDetails(context.Id))" />
                <AuthorizeView Context="MasterDataCountries" Policy="@MasterDataPermissions.MasterDataCountriesWrite">
                    <Authorized>
                        <ButtonEdit Size="Size.Small" OnClick="@(() => ShowDrawerEdit(context))" />
                        <ButtonDelete Size="Size.Small" OnClick="@(() => ShowDialogDelete(context))" />
                    </Authorized>
                </AuthorizeView>
            </MudStack>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</TableDefault>

@if (_isDrawerAddOpen)
{
    <DrawerAdd @bind-IsOpen="_isDrawerAddOpen" OnReload="LoadItems" />
}
@if (_isDrawerDetailsOpen)
{
    <DrawerDetails @bind-IsOpen="_isDrawerDetailsOpen" Country="_selectedCountry" />
}
@if (_isDrawerEditOpen)
{
    <DrawerEdit @bind-IsOpen="_isDrawerEditOpen" Model="_model" OnReload="LoadItems" />
}
