@inherits DrawerBase

<MudDrawer Variant="DrawerVariant.Temporary"
           Anchor="Anchor.Right"
           Width="500px"
           OverlayAutoClose="false"
           @bind-Open="IsOpen">
    <MudDrawerHeader>
        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Class="mud-width-full">
            <MudText Typo="Typo.h3">
                @CommonDisplayTextFor.Edit @CountriesDisplayTextFor.Country
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDrawer" />
        </MudStack>
    </MudDrawerHeader>
    <div class="pa-5">
        <ErrorViewer Exception="_exception" />
        <LoadingLinear IsVisible="_isLoading" />
        @if (Model is not null)
        {
            <MudForm @ref="_form" Model="Model" Validation="_validator.ValidateValue">
                <MudGrid>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@CommonDisplayTextFor.Code"
                                          @bind-Value="Model.Code"
                                          For="@(() => Model.Code)"
                                          Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <TextFieldDefault Label="@CommonDisplayTextFor.Name"
                                          @bind-Value="Model.Name"
                                          For="@(() => Model.Name)"
                                          Required="true" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
        <BottomButtonPanel>
            <ButtonCancel OnClick="CloseDrawer" />
            <ButtonSubmit OnClick="Submit" Disabled="_isLoading" />
        </BottomButtonPanel>
    </div>
</MudDrawer>
