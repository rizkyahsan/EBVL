@inherits DialogBase
@using EBVL.FrontEnd.Logics.Modules.MasterData.Questionnaires
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Models

<MudDialog>
    <DialogContent>
        <ErrorViewer Exception="@_exception" />
        <LoadingLinear IsVisible="@_isLoading" />
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12"><MudTextField Label="Questionnaire Name" @bind-Value="_model.Label" Required="true" Variant="Variant.Text" ShrinkLabel="true" MaxLines="10" AutoGrow="true" /></MudItem>
                <MudItem xs="12"><MudTextField Label="Description" @bind-Value="_model.Hint" Lines="3" Variant="Variant.Text" ShrinkLabel="true" MaxLines="10" AutoGrow="true" /></MudItem>
                <MudItem xs="12"><MudRadioGroup T="QuestionnaireQuestionType" @bind-Value="_model.Type"><MudText Typo="Typo.caption">Answer Type</MudText><MudRadio Value="@QuestionnaireQuestionType.ShortText">Textbox</MudRadio><MudRadio Value="@QuestionnaireQuestionType.LongText">Textarea</MudRadio><MudRadio Value="@QuestionnaireQuestionType.Address">Address</MudRadio><MudRadio Value="@QuestionnaireQuestionType.File">Upload File</MudRadio></MudRadioGroup></MudItem>
                <MudItem xs="12"><MudRadioGroup T="QuestionnaireAnswerRule" @bind-Value="_model.AnswerRule"><MudText Typo="Typo.caption">Answer Rule</MudText><MudRadio Value="@QuestionnaireAnswerRule.Mandatory">Mandatory (*)</MudRadio><MudRadio Value="@QuestionnaireAnswerRule.Optional">Optional</MudRadio><MudRadio Value="@QuestionnaireAnswerRule.AddedValue">Added Value (**)</MudRadio></MudRadioGroup></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="int" Label="Order" @bind-Value="_model.Order" Min="1" Required="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudRadioGroup T="bool" @bind-Value="_model.IsActive"><MudText Typo="Typo.caption">Active</MudText><MudRadio Value="true">Yes</MudRadio><MudRadio Value="false">No</MudRadio></MudRadioGroup></MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions><ButtonCancel OnClick="Cancel" Disabled="_isLoading" /><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_isLoading">Save</MudButton></DialogActions>
</MudDialog>
