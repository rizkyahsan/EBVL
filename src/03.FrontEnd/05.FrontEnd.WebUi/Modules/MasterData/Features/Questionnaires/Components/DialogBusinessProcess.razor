@inherits DialogBase
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Models
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12"><MudTextField Label="Code" Value="Model.Code" Disabled="true" Variant="Variant.Text" ShrinkLabel="true" /></MudItem>
                <MudItem xs="12"><MudSelect T="string" Label="Business Process" @bind-Value="Model.BusinessProcess" Required="true" Variant="Variant.Text" ShrinkLabel="true">@foreach (var process in QuestionnaireBusinessProcessFor.All) { <MudSelectItem Value="@process">@process</MudSelectItem> }</MudSelect></MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions><ButtonCancel OnClick="Cancel" /><MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Submit">Save</MudButton></DialogActions>
</MudDialog>
