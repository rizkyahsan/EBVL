@page "/MasterData/Questionnaires/Preview/{Id:guid}"
@inherits PageBase
@using EBVL.FrontEnd.Logics.Modules.MasterData.Questionnaires
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires
@* TODO: Restore QuestionnairePermissions.Read after IdAMan permission setup is complete. *@

<HtmlHead Title="Questionnaire Preview" />
<Breadcrumbs Items="@_breadcrumbItems" />
<PageHeader Title="Questionnaire Preview" />
<LoadingLinear IsVisible="@_isLoading" /><ErrorViewer Exception="@_exception" />
@if (_item is not null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Preview uses version @_item.Version graph metadata. Conditional rules are listed but not executed.</MudAlert>
    <MudPaper Class="pa-4 pa-sm-6" Outlined="true"><MudText Typo="Typo.h4">@_item.BusinessProcess</MudText><MudText Typo="Typo.caption">@_item.Code · @_item.Status</MudText>
        @foreach (var section in _item.Sections)
        {
            <MudText Typo="Typo.h6" Class="mt-6 mb-3">@section.Title <MudChip T="string" Size="Size.Small">@(section.CompanyType?.ToString() ?? "All vendors")</MudChip></MudText>
            @foreach (var question in section.Questions.Where(x => x.IsVisible))
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">@question.Label @Marker(question.AnswerRule)</MudText>
                @if (!string.IsNullOrWhiteSpace(question.Hint)) { <MudText Typo="Typo.caption">@question.Hint</MudText> }
                @switch (question.Type)
                {
                    case QuestionnaireQuestionType.Boolean: <MudSwitch T="bool" Label="Yes" Disabled="true" /> break;
                    case QuestionnaireQuestionType.SingleChoice: @foreach (var option in question.Options) { <MudText><MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked" Size="Size.Small" /> @option.Label</MudText> } break;
                    case QuestionnaireQuestionType.MultipleChoice: @foreach (var option in question.Options) { <MudCheckBox T="bool" Label="@option.Label" Disabled="true" /> } break;
                    case QuestionnaireQuestionType.LongText: <MudTextField T="string" Lines="3" Placeholder="@question.Placeholder" Variant="Variant.Outlined" Disabled="true" /> break;
                    case QuestionnaireQuestionType.Date: <MudDatePicker Placeholder="@question.Placeholder" Variant="Variant.Outlined" Disabled="true" /> break;
                    case QuestionnaireQuestionType.File: <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.UploadFile" Disabled="true">Select PDF</MudButton> break;
                    default: <MudTextField T="string" Placeholder="@question.Placeholder" Variant="Variant.Outlined" Disabled="true" /> break;
                }
            }
        }
    </MudPaper>
}

@code {
    private static string Marker(QuestionnaireAnswerRule rule) => rule switch { QuestionnaireAnswerRule.Mandatory => "*", QuestionnaireAnswerRule.AddedValue => "**", _ => string.Empty };
    [Parameter] public Guid Id { get; set; }
    private QuestionnaireDraftItem? _item;
    protected override async Task OnParametersSetAsync() { LoadBreadcrumbs(); try { _isLoading = true; _item = (await Sender.Send(new GetQuestionnaireQuery(Id))).Item; } catch (Exception ex) { _exception = ex; } finally { _isLoading = false; } }
    protected override void LoadBreadcrumbs() => _breadcrumbItems = [MainBreadcrumbFor.Home, MasterDataBreadcrumbFor.Index, new("Questionnaire", QuestionnaireRouteFor.Index), CommonBreadcrumbFor.Active("Preview")];
}
