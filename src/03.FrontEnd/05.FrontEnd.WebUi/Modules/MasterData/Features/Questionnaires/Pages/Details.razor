@page "/MasterData/Questionnaires/Details/{Id:guid}/{SectionId:guid}"
@inherits PageBase
@using EBVL.FrontEnd.Logics.Modules.MasterData.Questionnaires
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Components
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Models
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires
@* TODO: Add the Questionnaire IdAMan permission guard when its permissions are configured. *@

<HtmlHead Title="Detail Section" />
<Breadcrumbs Items="@_breadcrumbItems" />
<PageHeader Title="@(_section?.Title ?? "Detail Section")" />
<ErrorViewer Exception="@_exception" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap">
    @if (_item is not null)
    {
        <MudChip T="string" Size="Size.Small">@_item.Status / v@_item.Version</MudChip>
    }
    <MudSpacer />
    @if (_item?.Status != QuestionnaireStatus.Superseded)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Disabled="@_busy" OnClick="AddQuestion">Add New</MudButton>
    }
    <MudButton Variant="Variant.Outlined" Href="@QuestionnaireRouteFor.Index">Back</MudButton>
</MudStack>

@if (_section is not null)
{
<TableDefault ServerData="ReloadTable" @ref="_table" Loading="@_isLoading" Hover="true" Breakpoint="Breakpoint.Sm">
    <ToolBarContent><MudSpacer /><TextFieldSearch ValueChanged="OnSearch" Class="mt-0" /></ToolBarContent>
    <HeaderContent>
        <MudTh>No</MudTh>
        <MudTh><MudTableSortLabel T="QuestionnaireQuestionItem" SortLabel="label" InitialDirection="SortDirection.Ascending">Questionnaire Name</MudTableSortLabel></MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Answer Type</MudTh>
        <MudTh>Answer Rule</MudTh>
        <MudTh><MudTableSortLabel T="QuestionnaireQuestionItem" SortLabel="order">Order Number</MudTableSortLabel></MudTh>
        <MudTh>Status</MudTh>
        <MudTh Class="text-center">Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="No">@Number(context)</MudTd>
        <MudTd DataLabel="Questionnaire Name"><MudHighlighter Text="@context.Label" HighlightedText="@_search" /></MudTd>
        <MudTd DataLabel="Description"><MudHighlighter Text="@context.Hint" HighlightedText="@_search" /></MudTd>
        <MudTd DataLabel="Answer Type">@AnswerType(context.Type)</MudTd>
        <MudTd DataLabel="Answer Rule">@AnswerRule(context.AnswerRule)</MudTd>
        <MudTd DataLabel="Order Number">@context.Order</MudTd>
        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip></MudTd>
        <MudTd DataLabel="Action" Class="text-center">
            @if (_item?.Status != QuestionnaireStatus.Superseded)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" Disabled="@_busy" OnClick="@(() => EditQuestion(context))" title="Edit" />
            }
            @if (_item?.Status == QuestionnaireStatus.Draft)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Disabled="@_busy" OnClick="@(() => DeleteQuestion(context))" title="Delete" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">No questions found in this section.</MudText></NoRecordsContent>
    <LoadingContent><MudText Class="pa-4">Loading questions...</MudText></LoadingContent>
    <PagerContent><MudTablePager /></PagerContent>
</TableDefault>
}
else if (_isLoading)
{
    <LoadingLinear IsVisible="true" />
}
