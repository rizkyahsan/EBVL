@page "/MasterData/Questionnaires/Details/{Id:guid}/{SectionId:guid}"
@inherits PageBase
@using EBVL.FrontEnd.Logics.Modules.MasterData.Questionnaires
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Components
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Models
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Statics

<PageTitle>Questionnaire Detail</PageTitle>
<MudStack Spacing="3">
  <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
    <div>
      <MudText Typo="Typo.h5">Questionnaire Detail</MudText>
      <MudText Typo="Typo.body2" Color="Color.Secondary">@_item?.BusinessProcess / @_section?.Title</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Href="@QuestionnaireRouteFor.Index">Back</MudButton>
  </MudStack>
  <ErrorViewer Exception="@_exception" />
  <LoadingLinear IsVisible="@_isLoading" /> @if (_section is not null) { <MudTable Items="@_section.Questions.OrderBy(x => x.Order)" Filter="Filter" Hover="true" Breakpoint="Breakpoint.Sm">
    <ToolBarContent>
      <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddQuestion">Add New</MudButton>
      <MudSpacer />
      <TextFieldSearch @bind-Value="_search" />
    </ToolBarContent>
    <HeaderContent>
      <MudTh>@QuestionnaireDisplayTextFor.Number</MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => x.Label)" InitialDirection="SortDirection.Ascending">@QuestionnaireDisplayTextFor.QuestionnaireName</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => x.Hint ?? string.Empty)">@QuestionnaireDisplayTextFor.Description</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => AnswerType(x.Type))">@QuestionnaireDisplayTextFor.AnswerType</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => AnswerRule(x.AnswerRule))">@QuestionnaireDisplayTextFor.AnswerRule</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => x.Order)">@QuestionnaireDisplayTextFor.OrderNumber</MudTableSortLabel></MudTh>
      <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireQuestionItem, object>(x => x.IsActive)">@QuestionnaireDisplayTextFor.Active</MudTableSortLabel></MudTh>
      <MudTh Class="text-center">@QuestionnaireDisplayTextFor.Action</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.Number">@Number(context)</MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.QuestionnaireName"><MudHighlighter Text="@context.Label" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.Description"><MudHighlighter Text="@context.Hint" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.AnswerType"><MudHighlighter Text="@AnswerType(context.Type)" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.AnswerRule"><MudHighlighter Text="@AnswerRule(context.AnswerRule)" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.OrderNumber"><MudHighlighter Text="@context.Order.ToString()" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.Active"><MudHighlighter Text="@(context.IsActive ? "Yes" : "No")" HighlightedText="@_search" /></MudTd>
      <MudTd DataLabel="@QuestionnaireDisplayTextFor.Action" Class="text-center">
        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" OnClick="@(() => EditQuestion(context))" />
      </MudTd>
    </RowTemplate>
    <NoRecordsContent>
      <MudText Class="pa-4">No questionnaires have been added to this section.</MudText>
    </NoRecordsContent>
  </MudTable> }
</MudStack>
