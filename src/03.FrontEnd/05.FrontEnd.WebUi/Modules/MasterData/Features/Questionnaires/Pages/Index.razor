@page "/MasterData/Questionnaires"
@inherits PageBase
@using EBVL.FrontEnd.Logics.Modules.MasterData.Questionnaires
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Components
@using EBVL.Shared.Dto.Modules.MasterData.Questionnaires
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Models
@using EBVL.FrontEnd.WebUi.Modules.MasterData.Features.Questionnaires.Statics
@* TODO: Restore QuestionnairePermissions.Read after IdAMan permission setup is complete. *@

<HtmlHead Title="Questionnaire" />
<Breadcrumbs Items="@_breadcrumbItems" />
<PageHeader Title="Questionnaire" />
<ErrorViewer Exception="@_exception" />
@* TODO: Restore QuestionnairePermissions.Write after IdAMan permission setup is complete. *@
<TableDefault Items="_items" Loading="_isLoading" Filter="Filter">
    <ToolBarContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="ShowAdd">Add New</MudButton>
        <MudSpacer />
        <TextFieldSearch @bind-Value="_search" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@QuestionnaireDisplayTextFor.Number</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireListItem, object>(x => x.BusinessProcess)" InitialDirection="SortDirection.Ascending">@QuestionnaireDisplayTextFor.BusinessProcess</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireListItem, object>(x => Vendor(x.VendorType))">@QuestionnaireDisplayTextFor.VendorType</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireListItem, object>(x => x.Section)">@QuestionnaireDisplayTextFor.Section</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<QuestionnaireListItem, object>(x => x.IsSectionActive)">@QuestionnaireDisplayTextFor.Active</MudTableSortLabel></MudTh>
        <MudTh Class="text-center">@QuestionnaireDisplayTextFor.Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.Number">@Number(context)</MudTd>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.BusinessProcess">
            <MudHighlighter Text="@context.BusinessProcess" HighlightedText="@_search" />
        </MudTd>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.VendorType"><MudHighlighter Text="@Vendor(context.VendorType)" HighlightedText="@_search" /></MudTd>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.Section"><MudHighlighter Text="@context.Section" HighlightedText="@_search" /></MudTd>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.Active"><MudHighlighter Text="@(context.IsSectionActive ? "Yes" : "No")" HighlightedText="@_search" /></MudTd>
        <MudTd DataLabel="@QuestionnaireDisplayTextFor.Action" Class="text-center">
            <ButtonDetails Href="@QuestionnaireRouteFor.Details(context.QuestionnaireId, context.SectionId)" />
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" OnClick="@(() => EditSection(context))" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</TableDefault>
