@page "/MasterData/Users/Details/{Id:guid}"
@inherits PageBase
@attribute [Authorize(Policy = MasterDataPermissions.MasterDataUsersRead)]

<HtmlHead Title="@(_pageTitle)" />
<Breadcrumbs Items="@(_breadcrumbItems)" />
<PageHeader Title="@(_pageTitle)" EntityType="@UsersDisplayTextFor.User" />
<LoadingLinear IsVisible="@(_isLoading)" />
<ErrorViewer Exception="@(_exception)" />
@if (_item is not null)
{
    <HorizontalTabs>
        <MudTabPanel Text="@CommonDisplayTextFor.GeneralInfo">
            <AuthorizeView Policy="@MasterDataPermissions.MasterDataUsersWrite">
                <Authorized>
                    <TopButtonPanel>
                        <ButtonDelete OnClick="ShowDialogDelete" />
                    </TopButtonPanel>
                </Authorized>
            </AuthorizeView>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@UsersDisplayTextFor.Name">
                        @(_item.Name)
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@UsersDisplayTextFor.Username">
                        @_item.Username
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@UsersDisplayTextFor.Lender">
                        @_item.LenderName
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@UsersDisplayTextFor.PhoneNumber">
                        @_item.FullPhoneNumber
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@UsersDisplayTextFor.EmailAddress">
                        @_item.EmailAddress
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@CommonDisplayTextFor.Created">
                        @_item.Created.ToDisplayText(DateTimeFormatFor.LongDateTime)
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@CommonDisplayTextFor.CreatedBy">
                        @_item.CreatedBy
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@CommonDisplayTextFor.Modified">
                        @_item.Modified.ToDisplayText(DateTimeFormatFor.LongDateTime)
                    </FieldDefault>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="@CommonDisplayTextFor.ModifiedBy">
                        @_item.ModifiedBy.ToDisplayText()
                    </FieldDefault>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@AuditsDisplayTextFor.AuditLogs" BadgeData="_item.Audits.Count()">
            <TableAudits Audits="_item.Audits" />
        </MudTabPanel>
    </HorizontalTabs>
}
