<AuthorizeView Policy="@MasterDataPermissions.MasterData">
    <Authorized>
        <NavGroupDefault Title="@MasterDataDisplayTextFor.MasterData"
                         Icon="@Icons.Material.TwoTone.Dataset">
            <AuthorizeView Context="MasterDataCountries" Policy="@MasterDataPermissions.MasterDataCountriesRead">
                <Authorized>
                    <MudNavLink Href="@MasterDataCountriesRouteFor.Index"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.TwoTone.Flag">
                        @CountriesDisplayTextFor.Countries
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Context="MasterDataLenders" Policy="@MasterDataPermissions.MasterDataLendersRead">
                <Authorized>
                    <MudNavLink Href="@MasterDataLendersRouteFor.Index"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.TwoTone.AccountBalance">
                        @LendersDisplayTextFor.Lenders
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Context="MasterDataUsers" Policy="@MasterDataPermissions.MasterDataUsersRead">
                <Authorized>
                    <MudNavLink Href="@MasterDataUsersRouteFor.Index"
                                Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.TwoTone.VerifiedUser">
                        @UsersDisplayTextFor.Users
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
        </NavGroupDefault>
    </Authorized>
</AuthorizeView>
