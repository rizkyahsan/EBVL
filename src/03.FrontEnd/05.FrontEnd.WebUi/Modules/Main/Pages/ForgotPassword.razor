@page "/Authentication/Forgot-Password"
@layout Layouts.LayoutLanding
@attribute [AllowAnonymous]

<HtmlHead Title="Forgot Password" />
<LoadingOverlay IsVisible="@_isLoading" />
<ErrorViewer Exception="_exception" Class="mt-5" />

<main class="forgot-page">
    <section class="forgot-card">
        <h1>Forgot Password</h1>
        @if (_isSuccess)
        {
            <p class="forgot-message">@_successMessage</p>
            <a class="forgot-button" href="Authentication/Login-Vendor">Back to login</a>
        }
        else
        {
            <MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
                <MudTextField Label="Email / Username" @bind-Value="_model.UsernameOrEmail"
                              Immediate="true" autocomplete="username" Disabled="@_isLoading" />
                <button type="button" class="forgot-button" disabled="@_isLoading" @onclick="ExecuteRequest">
                    @(_isLoading ? "SENDING..." : "SEND RESET LINK")
                </button>
            </MudForm>
            <a class="forgot-back" href="Authentication/Login-Vendor">Back to login</a>
        }
    </section>
</main>
