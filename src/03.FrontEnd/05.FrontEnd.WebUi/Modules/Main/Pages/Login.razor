@page "/Authentication/Local-Login"
@layout Layouts.LayoutLanding
@attribute [AllowAnonymous]

<HtmlHead Title="@CommonDisplayTextFor.Login" />
<LoadingOverlay IsVisible="@(_isLoading)" />
<ErrorViewer Exception="_exception" Class="mt-5" />

<div class="landing-container">
    <MudContainer Class="pa-20">
        <Paper25 class="mud-height-full">
            <div class="illus-container rounded pa-20">
                <Paper25 Class="pa-10">
                    <PageHeader Title="@CommonDisplayTextFor.Login" />
                    <MudGrid>
                        <MudItem xs="12">
                            <TextFieldDefault Label="@CommonDisplayTextFor.Email"
                                              @bind-Value="_model.Username" />
                        </MudItem>
                        <MudItem xs="12">
                            <TextFieldDefault Label="Password" @bind-Value="_model.Password"
                                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                              OnAdornmentClick="@TogglePasswordVisibility" />
                        </MudItem>
                        <MudItem xs="12">
                            <ButtonReturn OnClick="ExecuteReturn" Disabled="@(_isLoading)"></ButtonReturn>
                            <ButtonPrimary OnClick="ExecuteLogin" Disabled="@(_isLoading)">
                                @CommonDisplayTextFor.Login
                            </ButtonPrimary>
                           
                        </MudItem>
                    </MudGrid>
                </Paper25>
            </div>
        </Paper25>
    </MudContainer>
</div>
