@page "/Authentication/Local-Login"
@layout Layouts.LayoutLanding
@attribute [AllowAnonymous]

<HtmlHead Title="@CommonDisplayTextFor.Login" />
<LoadingOverlay IsVisible="@(_isLoading)" />
<ErrorViewer Exception="_exception" Class="mt-5" />

<main class="login-page">
    <section class="login-artwork" aria-label="EBVL">
        <div class="login-card">
            <h1>Selamat Datang</h1>

            <div class="login-form-panel">
                <div class="login-field">
                    <label for="login-username">Email / Username</label>
                    <input id="login-username" @bind="_model.Username" autocomplete="username" placeholder="Masukkan Email" />
                </div>

                <div class="login-field">
                    <div class="login-password-label">
                        <label for="login-password">Password</label>
                        <span class="login-link">Lupa password</span>
                    </div>
                    <div class="login-password-input">
                        <input id="login-password" @bind="_model.Password" type="@(_showPassword ? "text" : "password")" autocomplete="current-password" placeholder="Masukkan Password" />
                        <button type="button" class="password-toggle" aria-label="Tampilkan password" @onclick="TogglePasswordVisibility">
                            <MudIcon Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" />
                        </button>
                    </div>
                </div>

                <p class="login-register">Belum punya akun? <a href="Vendor-Registration">Daftar sekarang</a></p>
            </div>

            <div class="login-actions">
                <button type="button" class="login-button login-button-back" @onclick="ExecuteReturn" disabled="@_isLoading">BACK</button>
                <button type="button" class="login-button login-button-submit" @onclick="ExecuteLogin" disabled="@_isLoading">LOGIN</button>
            </div>
        </div>
    </section>
</main>
