@page "/Landing"
@layout Layouts.LayoutLanding
@attribute [AllowAnonymous]

<HtmlHead Title="Login" />
<div class="landing-container">
    <div class="pa-8 rounded text-center">
        <div class="d-flex flex-column justify-center gap-3 mud-height-full">
            <div class="d-flex flex-column align-center gap-1">
                <!-- Logo Row -->
                <MudImage Src="@DisplayInfo.SrcLogo"
                          Alt="App Logo"
                          Style="display:block; margin:0 auto; width:100%; max-width:200px; height:auto;" />

                 <br/>
                <!-- App Nickname Row -->
                <MudText Typo="Typo.h1" Align="Align.Center">
                    Welcome to @AppConfigFrontEndOptions.Value.AppNickName
                </MudText>

                <!-- Login Instructions -->
                <MudText Typo="Typo.body1" Class="mb-4" Align="Align.Center">
                    Please <b>log in</b> with your account to get started.
                </MudText>

                <!-- Login Buttons -->
                <MudStack Row="true">
                    <a href="@_loginRoute" class="rounded border px-5 py-4 mud-border-lines-default button-login">
                        <div class="d-flex align-center gap-2">
                            <img src="img/logo-p.jpg" alt="@CommonDisplayTextFor.IdAMan" width="24" height="24" />
                            <span>
                                @($"{CommonDisplayTextFor.Login} Internal")
                            </span>
                        </div>
                    </a>
                    <MudDivider Vertical="true" FlexItem="true" />
                    <a href="@_localLoginRoute" class="rounded border px-5 py-4 mud-border-lines-default button-login">
                        <div class="d-flex align-center gap-2">
                            <span>
                                @($"{CommonDisplayTextFor.Login} External")
                            </span>
                        </div>
                    </a>
                </MudStack>
            </div>
        </div>
    </div>
    <div class="pa-4">
        <Paper25 class="mud-height-full">
            <div class="illus-container rounded">
                <div class="d-flex flex-column mud-height-full justify-start pa-8">
                    <p class="landing-title">
                        @AppConfigFrontEndOptions.Value.AppNickName
                    </p>
                </div>
            </div>
        </Paper25>
    </div>
</div>
