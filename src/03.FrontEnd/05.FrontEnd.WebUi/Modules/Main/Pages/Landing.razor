@page "/Landing"
@layout Layouts.LayoutLanding
@attribute [AllowAnonymous]

<HtmlHead Title="Login" />
<div class="landing-container">
    <div class="pa-8 rounded text-center">
        <div class="d-flex flex-column justify-center gap-3 mud-height-full">
            <div class="d-flex flex-column align-center gap-1">
                <MudText Typo="Typo.h1">
                    Welcome to @AppConfigFrontEndOptions.Value.AppNickName
                </MudText>
                <MudText Typo="Typo.subtitle1" Class="mb-6">
                    Electronic Brand Vendor List
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    Silakan masuk menggunakan akun internal atau akun vendor.
                </MudText>
                <div class="d-flex gap-3 flex-wrap justify-center">
                  <a href="@_loginRoute" class="rounded border px-5 py-4 mud-border-lines-default button-login">
                    <div class="d-flex align-center gap-2 justify-center">
                        <img src="img/logo-p.jpg" alt="@CommonDisplayTextFor.IdAMan" width="24" height="24" />
                        <span>Login with IdAMan</span>
                    </div>
                  </a>
                  <a href="Vendor/Login" class="rounded border px-5 py-4 mud-border-lines-default button-login">
                    <div class="d-flex align-center gap-2 justify-center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" />
                        <span>Login with Local Account</span>
                    </div>
                  </a>
                </div>
            </div>
        </div>
    </div>
    <div class="pa-4">
        <Paper25 class="mud-height-full">
            <div class="illus-container rounded">
                <div class="d-flex flex-column mud-height-full justify-start pa-8">
                    <p class="landing-title">
                        e-BVL Reengineering.
                    </p>
                </div>
            </div>
        </Paper25>
    </div>
</div>
