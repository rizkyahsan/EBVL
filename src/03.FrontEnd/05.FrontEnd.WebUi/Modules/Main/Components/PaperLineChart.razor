@using ApexCharts
@using EBVL.Shared.Dto.Modules.Examples.Orders.GetOrders

@inherits CommonComponentBase

<Paper25 Style="min-height: 416px;">
    <MudText Typo="Typo.h5">Order Net Value</MudText>
    @if (_isLoading)
    {
        <MudStack Class="text-center mt-2"
                  Style="height: 400px;"
                  Justify="Justify.FlexStart"
                  AlignItems="AlignItems.Center">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="20px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="90%" Height="300px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="20px" Class="mt-6" />
        </MudStack>
    }
    else
    {
        <ApexChart TItem="OrderItem"
                   Height="400"
                   Options="_options">
            <ApexPointSeries TItem="OrderItem"
                             Items="_orders"
                             Name="Gross Value"
                             SeriesType="SeriesType.Line"
                             XValue="@(e => e.Country)"
                             YAggregate="@(e => e.Sum(e => e.GrossValue))"
                             OrderByDescending="e => e.Y"
                             ShowDataLabels />
            <ApexPointSeries TItem="OrderItem"
                             Items="_orders"
                             Name="Net Value"
                             SeriesType="SeriesType.Line"
                             XValue="@(e => e.Country)"
                             YAggregate="@(e => e.Sum(e => e.NetValue))"
                             OrderByDescending="e => e.Y"
                             ShowDataLabels />
        </ApexChart>
    }
</Paper25>
