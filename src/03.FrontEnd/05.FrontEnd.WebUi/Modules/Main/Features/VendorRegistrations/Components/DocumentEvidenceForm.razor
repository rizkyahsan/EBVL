@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.DocumentEvidence
@using EBVL.Shared.Statics.VendorRegistrations

<div class="document-evidence-scope">
    <MudStack Spacing="3" Class="document-evidence-form">
        <MudGrid Spacing="3">
            @foreach (var definition in DocumentEvidenceFor.All)
            {
                var document = GetDocument(definition.Key);
                var inputId = $"evidence-{definition.Key}";
                <MudItem xs="12" md="6">
                    <div class="document-upload-row">
                        <MudText Typo="Typo.body1" Class="document-label">@GetDisplayName(definition.Key, definition.Name)</MudText>
                        <div class="upload-control">
                            <div class="file-name @(document.FileName is not null ? "file-selected" : null)" title="@document.FileName">
                                @(document.FileName ?? "Upload File")
                            </div>
                            <InputFile id="@inputId"
                                       class="evidence-file-input"
                                       OnChange="eventArgs => SelectFile(definition.Key, eventArgs)"
                                       accept="application/pdf,.pdf" />
                            <label for="@inputId" class="upload-button">
                                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                                <span>Upload</span>
                            </label>
                            @if (document.FileName is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Class="remove-file"
                                               OnClick="() => RemoveFile(definition.Key)"
                                               aria-label="@($"Remove {definition.Name}")" />
                            }
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_validationError</MudAlert>
        }

    </MudStack>
</div>
