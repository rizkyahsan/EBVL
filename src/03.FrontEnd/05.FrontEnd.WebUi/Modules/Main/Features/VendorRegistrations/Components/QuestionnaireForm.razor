@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.Questionnaire
@using EBVL.Shared.Statics.VendorRegistrations

<MudForm @ref="_form" Model="Model" Validation="_validator.ValidateValue">
    <div class="questionnaire-form-scope">
        <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="questionnaire-panels">
            <MudExpansionPanel Text="General" Expanded="true" Class="questionnaire-panel">
                <QuestionnaireGeneralForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Vendor / RO (Representative Office)" Class="questionnaire-panel">
                <QuestionnaireVendorROForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Sole Agent" Class="questionnaire-panel">
                <QuestionnaireSoleAgentForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Product Quality - General" Class="questionnaire-panel">
                <QuestionnaireProductQualityGeneralForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Product Quality - Spesific" Class="questionnaire-panel">
                <QuestionnaireProductQualitySpesificForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Product Positioning &amp; Technical Support" Class="questionnaire-panel">
                <QuestionnaireProductPositioningQuestionsForm Model="Model" OnChanged="NotifyChanged" />
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (!string.IsNullOrWhiteSpace(_validationError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_validationError</MudAlert>
        }

        <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="questionnaire-actions">
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Medium" Class="navigation-button" OnClick="OnBack">Previous</MudButton>
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Medium" Class="navigation-button" OnClick="Submit">Next</MudButton>
        </MudStack>
    </div>
</MudForm>
