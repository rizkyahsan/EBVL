@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.Questionnaire
@using EBVL.Shared.Statics.VendorRegistrations

<div class="question-section-scope">
        <MudGrid Spacing="3">
            @foreach (var question in Questions)
            {
                var answer = GetAnswer(question.Number);
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="question-label">
                        @question.Label <span class="question-mark">@(question.IsRequired ? "*" : "**")</span>
                    </MudText>
                    @if (question.IsFileUpload)
                    {
                        var fileInputId = $"question-file-{question.Number}";
                        <div class="file-upload-control @(Disabled ? "file-upload-disabled" : null)">
                            <InputFile id="@fileInputId" class="file-input" OnChange="eventArgs => UploadFile(question.Number, eventArgs)" accept="application/pdf,.pdf" disabled="@Disabled" />
                            <label for="@fileInputId" class="file-browser">
                                <span>@(answer.FileName ?? "Upload File")</span>
                            </label>
                            <label for="@fileInputId" class="file-upload-button mud-button-root mud-button-size-medium">
                                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                                <span>Upload</span>
                            </label>
                        </div>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Value="@answer.Value"
                                      ValueChanged="value => UpdateAnswer(question.Number, value)"
                                      Placeholder="@question.Placeholder"
                                      Required="@(question.IsRequired && !Disabled)"
                                      Disabled="@Disabled"
                                      RequiredError="Field wajib diisi."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="@(question.Number is 6 or 7 or 8 or 9 ? 2 : 1)" />
                    }
                </MudItem>
            }
        </MudGrid>
</div>
