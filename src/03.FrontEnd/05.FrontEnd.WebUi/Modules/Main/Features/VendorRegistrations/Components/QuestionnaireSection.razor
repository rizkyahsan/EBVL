@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.Questionnaire
@using EBVL.Shared.Statics.VendorRegistrations

<div class="question-section-scope">
<MudPaper Elevation="1" Class="question-section">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="section-header">
        <MudText Typo="Typo.h5" Class="section-title">@Title</MudText>
        @HeaderContent
    </MudStack>

    <MudPaper Elevation="0" Class="question-panel">
        <MudGrid Spacing="2" Class="align-center">
            @foreach (var question in Questions)
            {
                var answer = GetAnswer(question.Number);
                <MudItem xs="12" sm="5">
                    <MudText Typo="Typo.body2">
                        @question.Number. @(question.IsRequired ? "*" : string.Empty) @question.Label
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(question.Hint))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary"><i>@question.Hint</i></MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="7">
                    @if (question.IsFileUpload)
                    {
                        var fileInputId = $"question-file-{question.Number}";
                        <div class="file-upload-control @(Disabled ? "file-upload-disabled" : null)">
                            <InputFile id="@fileInputId" class="file-input" OnChange="eventArgs => UploadFile(question.Number, eventArgs)" disabled="@Disabled" />
                            <label for="@fileInputId" class="file-browser">
                                <MudIcon Icon="@Icons.Material.Filled.Search" />
                                <span>@(answer.FileName ?? "browse in folder")</span>
                            </label>
                            <label for="@fileInputId" class="file-upload-button">
                                <MudIcon Icon="@Icons.Material.Filled.Upload" />
                                <span>Upload File</span>
                            </label>
                        </div>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Value="@answer.Value"
                                      ValueChanged="value => UpdateAnswer(question.Number, value)"
                                      Placeholder="@question.Placeholder"
                                      Required="@(question.IsRequired && !Disabled)"
                                      Disabled="@Disabled"
                                      RequiredError="Field wajib diisi."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="@(question.Number is 6 or 7 or 8 or 9 ? 2 : 1)" />
                    }
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
</MudPaper>
</div>
