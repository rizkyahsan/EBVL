@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.PreRegistration
@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.Questionnaires

<div class="vendor-review-scope">
    <MudExpansionPanels MultiExpansion="true" Elevation="0">
        <MudExpansionPanel Text="1. Company Profile" Expanded="true" Class="review-accordion">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <ReviewField Label="SAP Number" Value="@PreRegistration.SapVendorNumber" />
                    <ReviewField Label="Company Name" Value="@PreRegistration.CompanyName" />
                    <ReviewField Label="Company Email Address" Value="@PreRegistration.CompanyEmail" />
                    <ReviewField Label="Company Phone Number" Value="@PreRegistration.CompanyPhoneNumber" />
                    <ReviewField Label="Company Website" Value="@PreRegistration.Website" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <ReviewField Label="PIC Email Address" Value="@PreRegistration.PicEmail" />
                    <ReviewField Label="PIC Phone Number" Value="@PreRegistration.PicPhoneNumber" />
                    <ReviewField Label="Company Business Model" Value="@PreRegistration.CompanyService?.GetDisplayText()" />
                    <ReviewField Label="Owner / Authorized Representative of Brand" Value="@GetBrands()" />
                    <ReviewField Label="Factory Address" Value="@($"{PreRegistration.FactoryCountry} - {PreRegistration.FactoryAddress}")" />
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>

        <MudExpansionPanel Text="2. Document Evidence" Class="review-accordion">
            <MudGrid Spacing="3">
                @foreach (var document in Runtime.Documents.OrderBy(item => item.Order))
                {
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body1">@document.Name</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true" Disabled="@(document.DocumentId is null)" OnClick="() => OnDownloadDocument.InvokeAsync(document)">@(document.FileName ?? "No file uploaded")</MudButton>
                    </MudItem>
                }
            </MudGrid>
        </MudExpansionPanel>

        <MudExpansionPanel Text="3. Questionnaire" Class="review-accordion">
            @foreach (var section in Runtime.Sections.OrderBy(item => item.Order))
            {
                <MudText Typo="Typo.h6" Class="questionnaire-section-title">@section.Title</MudText>
                <MudGrid Spacing="2" Class="questionnaire-review-grid">
                    @foreach (var question in section.Questions.OrderBy(item => item.Order))
                    {
                        <MudItem xs="12" md="6">
                            <ReviewField Label="@question.Label" Value="@GetAnswer(question)" />
                            @foreach (var file in question.Files) { <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="() => OnDownloadFile.InvokeAsync(file)">@file.FileName</MudButton> }
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>

    <div class="consent-row">
        <MudCheckBox T="bool" @bind-Value="_isConfirmed" Color="Color.Info" Size="Size.Medium" />
        <MudText Typo="Typo.body1">
            By checking this box, I confirm that I am an authorized representative of the company and that all provided information is accurate and true.
            I consent to the collection, processing, and storage of these data by <strong>PT Pertamina Patra Niaga</strong> for vendor registration and verification.
        </MudText>
    </div>

    <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="review-actions">
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Medium" Class="navigation-button" OnClick="OnPrevious">Previous</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Medium" Class="navigation-button" Disabled="@(!_isConfirmed)" OnClick="OnSendForVerification">Next</MudButton>
    </MudStack>
</div>
