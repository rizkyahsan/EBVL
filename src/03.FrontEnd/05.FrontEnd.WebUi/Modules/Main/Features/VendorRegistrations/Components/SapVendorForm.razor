@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.SapVendor

<MudForm @ref="_form" Model="Model" Validation="_validator.ValidateValue">
    <MudStack Spacing="2" Class="sap-vendor-form">
        <MudText Typo="Typo.body1" Align="Align.Center">SAP Vendor Number</MudText>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Start" Spacing="2" Class="sap-find-row">
            <div class="sap-input">
                    <MudTextField T="string"
                                  @bind-Value="Model.SapVendorNumber"
                                  For="@(() => Model.SapVendorNumber)"
                                  Required="true"
                                  RequiredError="Nomor SAP Vendor wajib diisi."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
            </div>
            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Outlined"
                       Color="Color.Info"
                       Class="find-button" Style="margin-top: 6px;"
                       OnClick="Submit">
                Find
            </MudButton>
        </MudStack>
    </MudStack>
</MudForm>
