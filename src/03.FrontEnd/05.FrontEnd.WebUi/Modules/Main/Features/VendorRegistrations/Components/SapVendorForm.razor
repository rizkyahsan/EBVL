@using EBVL.Shared.Dto.Modules.Main.VendorRegistrations.SapVendor

<MudForm @ref="_form" Model="Model" Validation="_validator.ValidateValue">
    <MudStack Spacing="3" Class="sap-vendor-form">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="form-title">
            Input nomor SAP Vendor
        </MudText>

        <MudPaper Elevation="0" Class="form-panel">
            <MudGrid Class="align-center" Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.body2">NO SAP Vendor</MudText>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField T="string"
                                  @bind-Value="Model.SapVendorNumber"
                                  For="@(() => Model.SapVendorNumber)"
                                  Required="true"
                                  RequiredError="Nomor SAP Vendor wajib diisi."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="form-actions">
            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Filled"
                       Color="Color.Error"
                       OnClick="OnBack">
                BACK
            </MudButton>
            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Filled"
                       Color="Color.Success"
                       OnClick="Submit">
                NEXT
            </MudButton>
        </MudStack>
    </MudStack>
</MudForm>
