@if (IsFile)
{
    <div class="document-item">
        <div class="document-file">
            <MudText Typo="Typo.body2" Class="document-label">@Label @if (IsRequired) { <span class="required-indicator">*</span> }</MudText>
            <div class="document-file-control">
                <MudTextField T="string" Value="@Value" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Variant="Variant.Outlined" OnClick="OnView" aria-label="@($"View {Label}")" />
            </div>
        </div>
        <div class="document-assessment item-assessment">
            <MudRadioGroup T="bool?" Value="@IsValid" ValueChanged="OnValidityChanged" Error="@(ShowValidationErrors && IsValid is null)" ErrorText="Pilih Valid atau Invalid.">
                <MudRadio T="bool?" Value="@((bool?)true)" Color="Color.Success">Valid</MudRadio>
                <MudRadio T="bool?" Value="@((bool?)false)" Color="Color.Error">Invalid</MudRadio>
            </MudRadioGroup>
            @RemarkField
        </div>
    </div>
}
else
{
    <div class="company-item">
        <div class="company-value">
            <MudText Typo="Typo.body2" Class="review-label">@Label</MudText>
            <MudTextField T="string" Value="@Value" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="item-assessment">
            <MudRadioGroup T="bool?" Value="@IsValid" ValueChanged="OnValidityChanged">
                <MudRadio T="bool?" Value="@((bool?)true)" Color="Color.Success">Valid</MudRadio>
                <MudRadio T="bool?" Value="@((bool?)false)" Color="Color.Error">Invalid</MudRadio>
            </MudRadioGroup>
            @RemarkField
        </div>
    </div>
}

@code {
    private RenderFragment RemarkField => @<MudTextField T="string"
                                                      Value="@Remark"
                                                      ValueChanged="OnRemarkChanged"
                                                      Label="Remark"
                                                      Placeholder="Masukkan remark"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      Disabled="@(IsValid is true)"
                                                      Required="@(IsValid is false)"
                                                      Error="@(ShowValidationErrors && IsValid is false && string.IsNullOrWhiteSpace(Remark))"
                                                      ErrorText="Remark wajib diisi untuk nilai Invalid."
                                                      Class="remark-field" />;
}
