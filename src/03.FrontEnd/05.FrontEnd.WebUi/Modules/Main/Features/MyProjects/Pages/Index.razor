@page "/MyProjects"
@inherits PageBase
@attribute [Authorize(Policy = MainPermissions.MainPageMyProjectRead)]

<HtmlHead Title="@(_pageTitle)" />
<Breadcrumbs Items="@(_breadcrumbItems)" />
<PageHeader Title="@(_pageTitle)" EntityType="@ProjectsDisplayTextFor.MyProject" />
<ErrorViewer Exception="@(_exception)" />
<LoadingOverlay IsVisible="@(_isLoading)" />

<TableDefault Items="_items" Loading="@(_isLoading)">
    <HeaderContent>
        <MudTh Style="width: 10%;">
            @CommonDisplayTextFor.No
        </MudTh>
        <MudTh>
            @ProjectsDisplayTextFor.Title
        </MudTh>
        <MudTh Style="width: 10%;" Class="text-center">
            @CommonDisplayTextFor.Status
        </MudTh>
        <MudTh Style="width: 20%;" Class="text-center">
            @CommonDisplayTextFor.Action
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@CommonDisplayTextFor.No">
            <MudIconButton Icon="@(IsExpanded(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small" OnClick="@(() => Toggle(context))" />
            @(GetRowNumber(context))
        </MudTd>
        <MudTd DataLabel="@ProjectsDisplayTextFor.Title">
            @(context.Title)
        </MudTd>
        <MudTd DataLabel="@CommonDisplayTextFor.Status" Class="text-center">
            <ChipStatus Value="@GetProjectStatusName(context)" StatusCode="@GetProjectStatusCode(context)" />
        </MudTd>
        <MudTd DataLabel="@CommonDisplayTextFor.Action" Class="text-center">
            <MudStack Row="true" Style="width:100%;" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                <ButtonDetails Size="Size.Small" OnClick="@(() => Details(context))" />
            </MudStack>
        </MudTd>
    </RowTemplate>
    <ChildRowContent Context="detailItem">
        @if (IsExpanded(detailItem.Id) && detailItem.ProjectStages.Any())
        {
            <MudTr>
                <td colspan="100">
                    <MudGrid Style="padding-left: 25px;">
                        <MudItem xs="12">
                            <TableDefault Items="detailItem.ProjectStages" Loading="@(_isLoading)">
                                <HeaderContent>
                                    <MudTh>
                                        @ProjectStagesDisplayTextFor.Name
                                    </MudTh>
                                    <MudTh>
                                        @ProjectStagesDisplayTextFor.Desc
                                    </MudTh>
                                    <MudTh Style="width: 20%;">
                                        @ProjectStagesDisplayTextFor.DueDate
                                    </MudTh>
                                    <MudTh Style="width: 10%;" Class="text-center">
                                        @CommonDisplayTextFor.Status
                                    </MudTh>
                                    <MudTh Style="width: 20%;" Class="text-center">
                                        @CommonDisplayTextFor.Action
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@ProjectStagesDisplayTextFor.Name">
                                        @(context.Name)
                                    </MudTd>
                                    <MudTd DataLabel="@ProjectStagesDisplayTextFor.Desc">
                                        @(context.Desc)
                                    </MudTd>
                                    <MudTd DataLabel="@ProjectStagesDisplayTextFor.DueDate">
                                        @($"{context.DueDate:dd-MMM-yyyy HH:mm:ss} WIB (GMT+7)")
                                    </MudTd>
                                    <MudTd DataLabel="@CommonDisplayTextFor.Status" Class="text-center">
                                        <ChipStatus Value="@context.StatusProjectLenderReqName"
                                                    StatusCode="@context.StatusProjectLenderReqCode"></ChipStatus>
                                    </MudTd>
                                    <MudTd DataLabel="@CommonDisplayTextFor.Action" Class="text-center">
                                        <MudStack Row="true" Style="width:100%;" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                                            @if (CanUpdate(context))
                                            {
                                                <ButtonUpdate Size="Size.Small" OnClick="@(() => StageUpdate(context))" />
                                            }
                                            else
                                            {
                                                <ButtonDetails Size="Size.Small" OnClick="@(() => StageDetails(context))" />
                                            }
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </TableDefault>
                        </MudItem>
                    </MudGrid>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</TableDefault>
