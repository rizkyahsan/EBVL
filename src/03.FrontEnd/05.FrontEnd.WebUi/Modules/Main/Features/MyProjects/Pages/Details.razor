@page "/MyProjects/Details/{Id:guid}"
@inherits PageBase
@attribute [Authorize(Policy = MainPermissions.MainPageMyProjectRead)]
@using EBVL.FrontEnd.WebUi.Modules.Main.Features.MyProjects.Components

<HtmlHead Title="@(_pageTitle)" />
<Breadcrumbs Items="@(_breadcrumbItems)" />
<PageHeader Title="@(_pageTitle)" EntityType="@ProjectsDisplayTextFor.MyProject" />
<LoadingOverlay IsVisible="@(_isLoading)" />
<ErrorViewer Exception="@(_exception)" />

@if (_item is not null)
{
    <PageSection>
        <ProgressBarStatusMyProject Width="@_width" ColspanProgressBar="@_colspanProgressBar" ProjectStatusCode="@_item.StatusCode"
                                    ProjectLenderStatusCode="@_item.ProjectLenderStatusCode" ListStage="@_projectStageList" />
    </PageSection>

    <PageSection>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@ProjectsDisplayTextFor.Title">
                    @_item.Title
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@ProjectsDisplayTextFor.Desc">
                    @_item.Desc
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@ProjectsDisplayTextFor.Objective">
                    @_item.Objective
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="6">
                <FieldDefault Label="@ProjectsDisplayTextFor.FinanceType">
                    @_item.FinanceType
                </FieldDefault>
            </MudItem>
            <MudItem xs="12" sm="12"></MudItem>
            @if (_item.ProjectLenderStatusCode == StatusesCodeFor.ProjectLenderWin
            || _item.ProjectLenderStatusCode == StatusesCodeFor.ProjectLenderLose)
            {
                <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-end">
                    @if (_item.FileStorageId.HasValue)
                    {
                        <ButtonDownload Size="Size.Small" OnClick="@(DownloadFileAttachment)" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FieldDefault Label="Note">
                        @if (string.IsNullOrWhiteSpace(_item.ProjectLenderNote))
                        {
                            <MudText Color="Color.Secondary">-</MudText>
                        }
                        else
                        {
                            <MudText>@_item.ProjectLenderNote</MudText>
                        }
                    </FieldDefault>
                </MudItem>
            }
        </MudGrid>
    </PageSection>

    <PageSection>
        <MudText Typo="Typo.h4" Class="mb-3">
            @($"{ProjectStagesDisplayTextFor.ProjectStage}")
        </MudText>

        <MudGrid>
            <MudItem xs="12">
                <TableDefault Items="@(_item.ProjectStages)" Loading="@(_isLoading)">
                    <HeaderContent>
                        <MudTh Style="width: 20%;">
                            @ProjectStagesDisplayTextFor.Name
                        </MudTh>
                        <MudTh Style="width: 30%;">
                            @ProjectStagesDisplayTextFor.Desc
                        </MudTh>
                        <MudTh Style="width: 20%;">
                            @ProjectStagesDisplayTextFor.DueDate
                        </MudTh>
                        <MudTh Style="width: 10%;" Class="text-center">
                            @CommonDisplayTextFor.Status
                        </MudTh>
                        <MudTh Style="width: 20%;" Class="text-center">
                            @CommonDisplayTextFor.Action
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@ProjectStagesDisplayTextFor.Name">
                            @context.Name
                        </MudTd>
                        <MudTd DataLabel="@ProjectStagesDisplayTextFor.Desc">
                            @context.Desc
                        </MudTd>
                        <MudTd DataLabel="@ProjectStagesDisplayTextFor.DueDate">
                            @($"{context.DueDate:dd-MMM-yyyy HH:mm:ss} WIB (GMT+7)")
                        </MudTd>
                        <MudTd DataLabel="@CommonDisplayTextFor.Status" Class="text-center">
                            @if (context.StatusCode == StatusesCodeFor.ProjectStageComplete)
                            {
                                <ChipStatus Value="@context.StatusProjectLenderReqName" StatusCode="@context.StatusProjectLenderReqCode"></ChipStatus>
                            }
                            else
                            {
                                <ChipStatus Value="@context.StatusName" StatusCode="@context.StatusCode"></ChipStatus>
                            }
                        </MudTd>
                        <MudTd DataLabel="@CommonDisplayTextFor.Action" Class="text-center">
                            <MudStack Row="true" Style="width:100%;" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1">
                                @if (context.StatusCode == StatusesCodeFor.ProjectStageOnProgress
                                && (context.StatusProjectLenderReqCode == StatusesCodeFor.ProjectLenderReqOnProgress
                                || context.StatusProjectLenderReqCode == StatusesCodeFor.ProjectLenderReqRevision)
                                && context.IsPicLender
                                && context.IsAllowUpdate)
                                {
                                    <ButtonUpdate Size="Size.Small" OnClick="@(() => StageUpdate(context))" />
                                }
                                else
                                {
                                    <ButtonDetails Size="Size.Small" OnClick="@(() => StageDetails(context))" />
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </TableDefault>
            </MudItem>
        </MudGrid>
    </PageSection>

    <BottomButtonPanel>
        <ButtonReturn OnClick="Cancel" Disabled="@(_isLoading)"></ButtonReturn>
    </BottomButtonPanel>
}
