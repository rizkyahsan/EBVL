@inherits DialogBase

<MudDialog>
    <DialogContent>
        <div class="confirm-dialog-scope">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="dialog-title">Submit Brand</MudText>
            <MudText Align="Align.Center">Brand akan disubmit dan status berubah menjadi Submitted. Lanjutkan?</MudText>
            <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="dialog-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="Confirm">Submit</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CloseDialog">Cancel</MudButton>
            </MudStack>
        </div>
    </DialogContent>
</MudDialog>
