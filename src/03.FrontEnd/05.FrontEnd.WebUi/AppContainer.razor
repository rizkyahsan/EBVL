@using EBVL.FrontEnd.WebUi.Modules.Main.Pages

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layouts.LayoutMain)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == false)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <AccessDenied />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <AuthorizeView>
            <Authorized>
                <LayoutView Layout="typeof(Layouts.LayoutMain)">
                    <NotFound />
                </LayoutView>
            </Authorized>
            <NotAuthorized>
                <LayoutView Layout="typeof(Layouts.LayoutLanding)">
                    <NotFound />
                </LayoutView>
            </NotAuthorized>
        </AuthorizeView>
    </NotFound>
</Router>
