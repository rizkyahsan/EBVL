<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Private Pertamina packages are restored from the repository-local,
       cross-platform offline feed. No TFS credentials are required. -->
  <packageSources>
    <clear />
    <add key="PertaminaOffline-1.0.4" value="packages/nuget-offline" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Override a machine/user-level setting that may disable nuget.org. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <packageSourceMapping>
    <packageSource key="PertaminaOffline-1.0.4">
      <package pattern="Pertamina.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
